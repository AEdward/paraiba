# Supabase Postgres — Project Settings > Database > Connection string.
# DATABASE_URL: transaction-mode pooler (port 6543, pgbouncer=true) — used by the app at runtime.
# DIRECT_URL: session-mode pooler or direct connection (port 5432) — used by Prisma Migrate.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres"

# Used to sign admin session cookies. Generate your own:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Seeded as the first admin account by `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# Your production domain (no protocol, no "www"), e.g. "paraiba.com".
# Lets the proxy recognize "<product-subdomain>.<ROOT_DOMAIN>" and route it
# to that product's own mini-site. You'll also need a wildcard DNS record
# (e.g. "*.paraiba.com") pointing at this deployment. Leave unset in local
# dev — "<subdomain>.localhost:3000" always works for testing regardless.
ROOT_DOMAIN=""
