// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  description  String
  status       String // "live" | "in-progress" | "concept" | "archived"
  tags         String // comma-separated
  link         String?
  screenshot   String? // used when no file was uploaded — a link to an already-hosted image
  screenshotData     Bytes? // set when the admin uploads a file directly; takes priority over `screenshot`
  screenshotMimeType String?
  embedLive    Boolean  @default(false) // render `link` in a live iframe instead of the screenshot
  githubRepo   String? // "owner/repo" — boots and renders the app live from source via StackBlitz, no deploy needed. Takes priority over embedLive.
  featured     Boolean  @default(false) // shown in the large showcase hero above the /projects grid
  deliverables String? // "## Category\n- item\n- item\n\n## Category\n..." — rendered as grouped cards
  caseStudy    String? // "## Section\nbody text\n\n## Section\n..." — rendered as numbered sections on the detail page
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A standalone, custom-designed marketing site for a product — fully
// independent of the Project catalog above (no GitHub repo/link, no
// tagline/status — those don't apply to a product that isn't deployed yet).
// Just a name, a subdomain, a logo, and a couple of theme colors; its actual
// content is a set of drag-and-drop-built ProductPages, same as the main site.
model ProductSite {
  id                  String        @id @default(cuid())
  name                String
  subdomain           String        @unique
  logoUrl             String? // used when no logo was uploaded — a link to an already-hosted image
  logoData            Bytes? // set when the admin uploads a file directly; takes priority over logoUrl
  logoMimeType        String?
  themeColor          String? // overrides --color-ember/--color-teal
  themeColorSecondary String? // overrides --color-amber
  pages               ProductPage[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// One page of a product site ("home" | "features" | "pricing" | "about" |
// "contact" | "demo"). Mirrors Page/Block — kept as a separate model so a
// product site's page slugs don't collide with the main site's Page.slug space.
model ProductPage {
  id            String         @id @default(cuid())
  productSiteId String
  productSite   ProductSite    @relation(fields: [productSiteId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  blocks        ProductBlock[]
  updatedAt     DateTime       @updatedAt
  createdAt     DateTime       @default(now())

  @@unique([productSiteId, slug])
}

model ProductBlock {
  id            String      @id @default(cuid())
  productPageId String
  productPage   ProductPage @relation(fields: [productPageId], references: [id], onDelete: Cascade)
  type          String
  order         Int         @default(0)
  data          Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productPageId, order])
}

model JobPosting {
  id           String           @id @default(cuid())
  title        String
  location     String
  type         String // "Full-time" | "Part-time" | "Contract"
  description  String
  status       String           @default("open") // "open" | "closed"
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id          String                @id @default(cuid())
  jobId       String
  job         JobPosting            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  coverLetter String?
  resumeUrl   String? // legacy — kept for applications submitted before file upload existed
  documents   ApplicationDocument[]
  status      String                @default("new") // "new" | "reviewed" | "shortlisted" | "rejected" | "hired"
  createdAt   DateTime              @default(now())
}

// An uploaded file (resume/CV, portfolio, cover letter, etc.) attached to a
// job application. Stored as bytes directly (not via MediaAsset) since these
// are private applicant documents, never served by the public /api/media
// route — only the admin-only applicants download route can read them.
model ApplicationDocument {
  id               String         @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  fileName         String
  mimeType         String
  data             Bytes
  createdAt        DateTime       @default(now())
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String? // used when no logo was uploaded — a link to an already-hosted image
  logoData     Bytes? // set when the admin uploads a file directly; takes priority over logoUrl
  logoMimeType String?
  website      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A page in the drag-and-drop CMS ("home" | "about" | "careers" | "contact" |
// "products"). Its content is an ordered list of Blocks — the page itself
// carries no copy, just identity + ordering.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String // internal label shown in the admin, not rendered on the site
  published Boolean  @default(true) // when false, the public route 404s; the admin builder is unaffected
  blocks    Block[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// One section of a page. `type` selects which React component renders it
// (see src/lib/blocks/types.ts) and `data` is that type's JSON shape —
// schemaless in the database so new block types don't need a migration.
model Block {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  order     Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

// A single uploaded image referenced by id from a "section" block's freeform
// elements (image/gallery/cover/mediaText) — mirrors the ProductSite/Partner
// logo pattern (binary + mimeType, served via /api/media/[id]), but as its
// own row since one section can reference many images across many elements.
model MediaAsset {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Single-row table (id is always "singleton") holding the site-wide contact
// details and social links shown on the Contact page and in the Footer —
// one place to edit them from /admin/settings instead of duplicating the
// same fields in multiple blocks.
model SiteSettings {
  id             String   @id @default("singleton")
  officeLocation String   @default("Addis Ababa, Ethiopia")
  phone          String?
  email          String   @default("hello@paraiba.com")
  mapEmbedUrl    String? // a Google Maps "Embed a map" iframe src URL
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  telegramUrl    String?
  youtubeUrl     String?
  linkedinUrl    String?
  updatedAt      DateTime @updatedAt
}

// A navigation link the admin manages from /admin/menu — shown in the
// header nav, the footer, or both. `group` optionally clusters items into
// a labeled dropdown (header) or column (footer) — e.g. several items with
// group "Company" render together. Ungrouped items render as flat links.
// When `href` points at a CMS Page (e.g. "/solutions"), that page's
// `published` flag is checked at render time and the link is hidden if
// it's unpublished — never a manual admin step.
model NavItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  location  String   @default("both") // "header" | "footer" | "both"
  group     String? // e.g. "Company" — clusters items into one dropdown/column
  order     Int      @default(0)
  newTab    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
