// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  tagline      String
  description  String
  status       String // "live" | "in-progress" | "concept" | "archived"
  tags         String // comma-separated
  link         String?
  screenshot   String?
  embedLive    Boolean  @default(false) // render `link` in a live iframe instead of the screenshot
  githubRepo   String? // "owner/repo" — boots and renders the app live from source via StackBlitz, no deploy needed. Takes priority over embedLive.
  featured     Boolean  @default(false) // shown in the large showcase hero above the /projects grid
  deliverables String? // "## Category\n- item\n- item\n\n## Category\n..." — rendered as grouped cards
  caseStudy    String? // "## Section\nbody text\n\n## Section\n..." — rendered as numbered sections on the detail page
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Optional standalone mini-site: <subdomain>.<root domain>, its own set of
  // pages (see ProductPage below), and its own accent colors instead of
  // Paraiba's. Unset fields fall back to the main brand's look.
  subdomain           String?       @unique
  logoUrl             String?
  themeColor          String? // overrides --color-ember/--color-teal
  themeColorSecondary String? // overrides --color-amber
  pages               ProductPage[]
}

// One page of a product's own mini-site ("home" | "features" | "pricing" |
// "about" | "contact" | "demo"). Mirrors Page/Block — kept as a separate
// model (rather than a nullable Page.projectId) so a product's page slugs
// don't collide with, or get mixed up with, the main site's Page.slug space.
model ProductPage {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  blocks    ProductBlock[]
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  @@unique([projectId, slug])
}

model ProductBlock {
  id            String      @id @default(cuid())
  productPageId String
  productPage   ProductPage @relation(fields: [productPageId], references: [id], onDelete: Cascade)
  type          String
  order         Int         @default(0)
  data          Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productPageId, order])
}

model JobPosting {
  id           String           @id @default(cuid())
  title        String
  location     String
  type         String // "Full-time" | "Part-time" | "Contract"
  description  String
  status       String           @default("open") // "open" | "closed"
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id          String     @id @default(cuid())
  jobId       String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  coverLetter String?
  resumeUrl   String?
  status      String     @default("new") // "new" | "reviewed" | "shortlisted" | "rejected" | "hired"
  createdAt   DateTime   @default(now())
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String? // used when no logo was uploaded — a link to an already-hosted image
  logoData     Bytes? // set when the admin uploads a file directly; takes priority over logoUrl
  logoMimeType String?
  website      String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A page in the drag-and-drop CMS ("home" | "about" | "careers" | "contact" |
// "products"). Its content is an ordered list of Blocks — the page itself
// carries no copy, just identity + ordering.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String // internal label shown in the admin, not rendered on the site
  blocks    Block[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// One section of a page. `type` selects which React component renders it
// (see src/lib/blocks/types.ts) and `data` is that type's JSON shape —
// schemaless in the database so new block types don't need a migration.
model Block {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  order     Int      @default(0)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
